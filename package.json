{
  "name": "@aj1181/kiln",
  "version": "0.1.2",
  "description": "A Lovable-grade product shell for terminal coding agents. One command turns an empty directory into a running app you can look at.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "kiln": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "opencode",
    "lovable",
    "scaffold",
    "vibe-coding",
    "terminal",
    "devtools"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "dev": "node src/cli.ts",
    "build": "npm run build:src && npm run build:ui",
    "build:src": "tsc -p tsconfig.build.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "check": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "probe": "node src/probe/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/acorn": "^4.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjav1181/kiln.git"
  },
  "homepage": "https://github.com/arjav1181/kiln",
  "bugs": {
    "url": "https://github.com/arjav1181/kiln/issues"
  }
}
